# OBSで「ツール」→「WebSocketサーバー設定」に表示されるパスワード
OBS_PASSWORD=""

# OBSで作成したテキストソースの名前（必須）
OBS_INPUT_NAME=字幕
# ひとつ前の発話を表示するOBSテキストソース名（不要なら空欄）
OBS_PREVIOUS_INPUT_NAME=

# 通常は変更不要
OBS_URL=ws://127.0.0.1:4455
# UDトークの「ウェブで公開」で発行したURL
UDTALK_PUBLIC_URL="https://live.udtalk.jp/ここに64文字のID"
POLL_MS=500
# UDトーク通信全体とTCP・TLS接続処理の上限（本文受信を含む）
UDTALK_REQUEST_TIMEOUT_MS=5000
# 連続失敗時に延ばす再試行間隔の上限（POLL_MS以上）
UDTALK_RETRY_MAX_MS=10000
# 1行あたりの最大文字数。OBSの字幕幅に合わせて調整
MAX_CHARS_PER_LINE=24

RECONNECT_MS=2000
